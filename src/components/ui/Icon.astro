---
import type { IconKey } from "../../utils/getIcon";
import { getIconData } from "../../utils/getIcon";

interface Props {
  icon: IconKey;
  class?: string;
  changeColorOnHover?: boolean;
  inheritColor?: boolean;
  scaleOnHover?: boolean;
}

const {
  icon,
  class: className = "",
  changeColorOnHover = true,
  inheritColor = false,
  scaleOnHover = true,
} = Astro.props;

const iconData = getIconData(icon);
---

{
  iconData?.type === "simple" && (
    <svg
      viewBox="0 0 24 24"
      data-tech-icon={icon}
      class={`h-5 w-5 shrink-0 transition-all duration-200 ${className} text-(--tech-color) ${scaleOnHover ? "group-hover:scale-150" : ""}`}
      style={`--tech-color: #${iconData.icon.hex}`}
      fill="currentColor"
    >
      <path d={iconData.icon.path} />
    </svg>
  )
}

{
  iconData?.type === "lucide" && (
    <iconData.icon
      className={`h-5 w-5 shrink-0 transition-all duration-200 ${className} ${inheritColor ? "" : "text-text-primary"} ${changeColorOnHover ? "group-hover:text-lilac-600" : ""} ${scaleOnHover ? "group-hover:scale-150" : ""}`}
    />
  )
}
